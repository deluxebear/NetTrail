    "NetTrail uses a content filter that only observes, never blocks, to record the domains each app connects to. Data stays on this Mac.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "网迹使用一个只观察、不拦截的内容过滤器来记录各 App 访问的域名。数据只保存在本机。"
          }
        }
      }
    },
